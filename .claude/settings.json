{
  "permissions": {
    "deny": [
      "Read(**/*.pem)",
      "Read(**/id_rsa*)",
      "Bash(git push --force:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git push -f:*)",
      "Bash(git filter-branch:*)",
      "Bash(npm publish:*)"
    ]
  },
  "enabledPlugins": {
    "deadweight@deadweight": true
  },
  "extraKnownMarketplaces": {
    "deadweight": {
      "source": {
        "source": "github",
        "repo": "e-xode/deadweight"
      }
    }
  },
  "outputStyle": "exode-dev"
}
