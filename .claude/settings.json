{
  "model": "sonnet",
  "permissions": {
    "deny": [
      "Read(**/*.pem)",
      "Read(**/id_rsa*)",
      "Bash(git push --force:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git push -f:*)",
      "Bash(git filter-branch:*)",
      "Bash(npm publish:*)"
    ],
    "allow": [
      "WebFetch"
    ]
  },
  "enabledPlugins": {
    "deadweight@e-xode": true
  },
  "extraKnownMarketplaces": {
    "e-xode": {
      "source": {
        "source": "github",
        "repo": "e-xode/deadweight"
      }
    }
  },
  "outputStyle": "exode-dev",
  "statusLine": {
    "type": "command",
    "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/statusline.py"
  }
}
